project Tetris_Tests is
   for Source_Dirs use (".", "../src");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use ".";
   for Main use ("logic_test.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-O2");
   end Compiler;
end Tetris_Tests;
